{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "fast_api_service.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "44000"
      ],
      "cwd": "/app",
      "env": {
        "PYTHONPATH": "/app"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true
    }
  ]
}